{
  "name": "compact-tool-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Compact TUI renderers for pi read, write, bash, edit, and codemode tools.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "tools-ui"
  ],
  "main": "./index.ts",
  "files": [
    "README.md",
    "commands/",
    "components/",
    "core-utils.ts",
    "docs/",
    "format/",
    "index.ts",
    "renderers/",
    "settings/",
    "style.ts",
    "tui-utils.ts"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --import ./test/register-ts-loader.mjs --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^24.3.0",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "^5.7.3"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  }
}
