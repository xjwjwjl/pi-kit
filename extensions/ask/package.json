{
  "name": "pi-ask-user",
  "version": "1.0.0",
  "private": true,
  "description": "A lightweight structured ask-user tool for pi. Supports free text, single choice, multiple choice, and custom answers in a tabbed multi-question dialog.",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "benchmark": "node test/benchmark.mjs"
  },
  "license": "MIT",
  "author": "",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "24.12.4",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
