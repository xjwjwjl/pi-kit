    "extensions/beta/index.ts": [
      "import { Queue } from './src/queue.ts';",
      "import { resolveJob } from './src/policy.ts';",
      "export default function beta(pi: any) {",
      "  const queue = new Queue(3);",
      "  pi.registerTool({",
      "    name: 'run_job', parameters: {type:'object',properties:{job:{type:'string'}}},",
      "    async execute(_id: string, input: {job:string}, signal: AbortSignal) {",
      "      const job = resolveJob(input.job);",
      "      return queue.run(job, signal);",
      "    },",
      "  });",
      "  pi.on('session_shutdown', () => queue.close());",
      "}",
      ""
    ],
    "extensions/beta/src/queue.ts": [
      "type Job = (signal: AbortSignal) => Promise<string>;",
      "interface Ticket {",
      "  job: Job; controller: AbortController;",
      "  resolve(value: string): void; reject(reason: unknown): void;",
      "}",
      "export class Queue {",
      "  private waiting: Ticket[] = [];",
      "  private running = new Map<AbortController, Promise<void>>();",
      "  private closing = false;",
      "  constructor(private limit: number) {",
      "    if (!Number.isInteger(limit) || limit < 1) throw new Error('invalid limit');",
      "  }",
      "  run(job: Job, signal: AbortSignal): Promise<string> {",
      "    if (this.closing) return Promise.reject(new Error('closed'));",
      "    if (signal.aborted) return Promise.reject(signal.reason);",
      "    return new Promise((resolve, reject) => {",
      "      const controller = new AbortController();",
      "      const ticket = { job, controller, resolve, reject };",
      "      const abort = () => {",
      "        controller.abort(signal.reason);",
      "        const index = this.waiting.indexOf(ticket);",
      "        if (index >= 0) { this.waiting.splice(index, 1); reject(signal.reason); }",
      "      };",
      "      signal.addEventListener('abort', abort, { once: true });",
      "      this.waiting.push(ticket);",
      "      this.pump(() => signal.removeEventListener('abort', abort));",
      "    });",
      "  }",
      "  private pump(after: () => void = () => {}) {",
      "    while (!this.closing && this.running.size < this.limit && this.waiting.length) {",
      "      const ticket = this.waiting.shift()!;",
      "      const done = Promise.resolve().then(() => ticket.job(ticket.controller.signal))",
      "        .then(ticket.resolve, ticket.reject).finally(() => {",
      "          this.running.delete(ticket.controller);",
      "          after();",
      "          this.pump();",
      "        });",
      "      this.running.set(ticket.controller, done);",
      "    }",
      "  }",
      "  async close() {",
      "    this.closing = true;",
      "    for (const ticket of this.waiting.splice(0)) ticket.reject(new Error('closed'));",
      "    for (const controller of this.running.keys()) controller.abort();",
      "    await Promise.allSettled([...this.running.values()]);",
      "  }",
      "}",
      ""
    ],
    "extensions/beta/src/policy.ts": [
      "const allowed = new Map<string, (signal: AbortSignal) => Promise<string>>([",
      "  ['catalog', async signal => { signal.throwIfAborted(); return 'catalog ready'; }],",
      "  ['summary', async signal => { signal.throwIfAborted(); return 'summary ready'; }],",
      "]);",
      "export function resolveJob(name: string) {",
      "  if (name.trim() !== name || name.includes('/')) throw new Error('invalid name');",
      "  const job = allowed.get(name);",
      "  if (!job) throw new Error('unknown job');",
      "  return job;",
      "}",
      ""
    ],
    "extensions/beta/test/queue.test.ts": [
      "import { test } from 'node:test';",
      "import assert from 'node:assert/strict';",
      "import { Queue } from '../src/queue.ts';",
      "import { resolveJob } from '../src/policy.ts';",
      "test('unknown jobs are refused before running', () => {",
      "  assert.throws(() => resolveJob('shell'), /unknown/);",
      "});",
      "test('closed queue never accepts work', async () => {",
      "  const q = new Queue(1);",
      "  await q.close();",
      "  await assert.rejects(q.run(async () => 'x', new AbortController().signal), /closed/);",
      "});",
      ""
