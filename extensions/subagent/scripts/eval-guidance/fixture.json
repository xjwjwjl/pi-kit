    "extensions/alpha/package.json": [
      "{",
      "  \"name\": \"alpha\",",
      "  \"private\": true,",
      "  \"type\": \"module\",",
      "  \"scripts\": {",
      "    \"check\": \"tsc --noEmit && node --test test/*.test.ts\"",
