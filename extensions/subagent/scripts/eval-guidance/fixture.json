    "extensions/alpha/index.ts": [
      "import { Batcher } from './src/batcher.ts';",
      "import { createChannel } from './src/channel.ts';",
      "export default function alpha(pi: any) {",
      "  let batcher: Batcher | undefined;",
      "  let unsubscribe: (() => void) | undefined;",
      "  pi.on('session_start', () => {",
      "    if (batcher) return;",
      "    const channel = createChannel();",
      "    batcher = new Batcher(channel.send, 16, 100);",
      "    unsubscribe = channel.subscribe(event => batcher?.push(event));",
      "  });",
      "  pi.on('session_shutdown', async () => {",
      "    unsubscribe?.();",
      "    unsubscribe = undefined;",
      "    const owner = batcher;",
      "    batcher = undefined;",
      "    await owner?.close();",
      "  });",
      "}",
      ""
    ],
    "extensions/alpha/src/batcher.ts": [
      "export interface Event { id: string; body: string }",
      "type Send = (events: Event[], signal: AbortSignal) => Promise<void>;",
      "export class Batcher {",
      "  private pending: Event[] = [];",
      "  private timer?: ReturnType<typeof setTimeout>;",
      "  private closed = false;",
      "  private active?: { controller: AbortController; done: Promise<void> };",
      "  private seen = new Set<string>();",
      "  constructor(private send: Send, private capacity = 16, private delayMs = 100) {}",
      "  push(event: Event): boolean {",
      "    if (this.closed || this.seen.has(event.id)) return false;",
      "    if (this.pending.length >= this.capacity) return false;",
      "    this.pending.push({ ...event });",
      "    this.seen.add(event.id);",
      "    this.schedule();",
      "    return true;",
      "  }",
      "  private schedule() {",
      "    if (this.closed || this.active || this.timer || this.pending.length === 0) return;",
      "    this.timer = setTimeout(() => { this.timer = undefined; void this.flush(); }, this.delayMs);",
      "  }",
      "  async flush() {",
      "    if (this.closed || this.active || this.pending.length === 0) return;",
      "    const batch = this.pending.splice(0, this.capacity);",
      "    const controller = new AbortController();",
      "    const done = this.send(batch, controller.signal).catch(() => {",
      "      if (!this.closed) this.pending.unshift(...batch);",
      "    }).finally(() => {",
      "      if (this.active?.controller === controller) this.active = undefined;",
      "      this.schedule();",
      "    });",
      "    this.active = { controller, done };",
      "    await done;",
      "  }",
      "  async close() {",
      "    if (this.closed) return;",
      "    this.closed = true;",
      "    if (this.timer) clearTimeout(this.timer);",
      "    this.timer = undefined;",
      "    this.pending = [];",
      "    const active = this.active;",
      "    active?.controller.abort();",
      "    await active?.done;",
      "    this.seen.clear();",
      "  }",
      "}",
      ""
    ],
    "extensions/alpha/src/channel.ts": [
      "import type { Event } from './batcher.ts';",
      "export function createChannel() {",
      "  const listeners = new Set<(event: Event) => void>();",
      "  return {",
      "    subscribe(listener: (event: Event) => void) {",
      "      listeners.add(listener);",
      "      return () => { listeners.delete(listener); };",
      "    },",
      "    receive(event: Event) {",
      "      for (const listener of [...listeners]) listener({ ...event });",
      "    },",
      "    async send(events: Event[], signal: AbortSignal) {",
      "      signal.throwIfAborted();",
      "      for (const event of events) {",
      "        if (!event.id || !event.body) throw new Error('invalid event');",
      "        await Promise.resolve();",
      "        signal.throwIfAborted();",
      "      }",
      "    },",
      "  };",
      "}",
      ""
    ],
    "extensions/alpha/test/batcher.test.ts": [
      "import { test } from 'node:test';",
      "import assert from 'node:assert/strict';",
      "import { Batcher } from '../src/batcher.ts';",
      "test('duplicate IDs and capacity are rejected', async () => {",
      "  const b = new Batcher(async () => {}, 1);",
      "  assert.equal(b.push({id:'1',body:'x'}), true);",
      "  assert.equal(b.push({id:'1',body:'x'}), false);",
      "  assert.equal(b.push({id:'2',body:'y'}), false);",
      "  await b.close();",
      "});",
      "test('shutdown rejects new input', async () => {",
      "  const b = new Batcher(async () => {});",
      "  await b.close();",
      "  assert.equal(b.push({id:'1',body:'x'}), false);",
      "});",
