    "extensions/gamma/index.ts": [
      "import { Rail } from './src/rail.ts';",
      "import { loadSettings } from './src/settings.ts';",
      "export default function gamma(pi: any) {",
      "  const settings = loadSettings({}, {});",
      "  const views = new Set<Rail>();",
      "  pi.registerToolRenderer((name: string) => {",
      "    if (name !== 'read') return undefined;",
      "    return { renderResult(result: any, options: any, theme: any) {",
      "      const view = new Rail(result, options.expanded, theme, settings);",
      "      views.add(view);",
      "      return view;",
      "    }};",
      "  });",
      "  pi.on('theme_change', () => { for (const view of views) view.invalidate(); });",
      "  pi.on('session_shutdown', () => { views.clear(); });",
      "}",
      ""
    ],
    "extensions/gamma/src/rail.ts": [
      "import type { Settings } from './settings.ts';",
      "export class Rail {",
      "  private cache?: { width: number; palette: unknown; expanded: boolean; lines: string[] };",
      "  constructor(private result: any, private expanded: boolean, private theme: any, private settings: Settings) {}",
      "  invalidate() { this.cache = undefined; }",
      "  setExpanded(value: boolean) {",
      "    if (this.expanded === value) return;",
      "    this.expanded = value;",
      "    this.invalidate();",
      "  }",
      "  render(width: number): string[] {",
      "    const palette = this.theme.colors;",
      "    if (this.cache?.width === width && this.cache.palette === palette && this.cache.expanded === this.expanded) {",
      "      return [...this.cache.lines];",
      "    }",
      "    const body = this.result.content.filter((p: any) => p.type === 'text').map((p: any) => p.text).join('\\n');",
      "    const plain = body.replace(/\\t/g, '   ').replace(/\\x1b\\[[0-9;]*m/g, '');",
      "    const logical = this.expanded ? plain.split('\\n') : [this.result.isError ? 'read failed' : 'read complete'];",
      "    const usable = Math.max(1, width - 2);",
      "    const lines = logical.flatMap((line: string) => {",
      "      const chunks: string[] = [];",
      "      const points = [...line];",
      "      do { chunks.push('│ ' + points.splice(0, usable).join('')); } while (points.length);",
      "      return chunks;",
      "    });",
      "    const visible = this.expanded ? lines : lines.slice(0, this.settings.previewLines);",
      "    this.cache = { width, palette, expanded: this.expanded, lines: visible };",
      "    return [...visible];",
      "  }",
      "}",
      ""
    ],
    "extensions/gamma/src/settings.ts": [
      "export interface Settings { previewLines: number; shell: 'self' | 'default' }",
      "const defaults: Settings = { previewLines: 1, shell: 'self' };",
      "function valid(input: Partial<Settings>): Partial<Settings> {",
      "  const output: Partial<Settings> = {};",
      "  if (Number.isInteger(input.previewLines) && input.previewLines! >= 1) output.previewLines = input.previewLines;",
      "  if (input.shell === 'self' || input.shell === 'default') output.shell = input.shell;",
      "  return output;",
      "}",
      "export function loadSettings(global: Partial<Settings>, project: Partial<Settings>, trusted = false): Settings {",
      "  return { ...defaults, ...valid(global), ...(trusted ? valid(project) : {}) };",
      "}",
      "export async function saveSettings(next: Settings, save: (value: Settings) => Promise<void>, apply: (value: Settings) => void) {",
      "  await save({ ...next });",
      "  apply({ ...next });",
      "}",
      ""
    ],
    "extensions/gamma/test/rail.test.ts": [
      "import { test } from 'node:test';",
      "import assert from 'node:assert/strict';",
      "import { Rail } from '../src/rail.ts';",
      "import { loadSettings } from '../src/settings.ts';",
      "test('project values require trust', () => {",
      "  assert.equal(loadSettings({}, {previewLines:4}).previewLines, 1);",
      "});",
      "test('returned lines are copies', () => {",
      "  const rail = new Rail({content:[{type:'text',text:'hello'}]}, false, {colors:{}}, loadSettings({},{}));",
      "  rail.render(80).push('mutation');",
      "  assert.equal(rail.render(80).length, 1);",
      "});",
      ""
