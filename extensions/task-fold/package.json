{
  "name": "task-fold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fold completed Pi task thinking and tool calls in the interactive transcript.",
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:e2e": "python3 test/e2e/bundled-tui.py",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": ["./index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  }
}
